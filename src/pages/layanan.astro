---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { businessLines } from '../data/content';
---

<BaseLayout
  title="Bidang Perdagangan | PT Sentra Niagatama Indonesia"
  description="Bidang usaha PT Sentra Niagatama Indonesia menurut KBLI 2025: platform digital perdagangan eceran, portal intermediasi pos dan kurir, serta eceran barang baru."
>
  <PageHero
    eyebrow="Bidang Perdagangan"
    title="Bidang usaha menurut klasifikasi resmi."
    intro="Kegiatan usaha PT Sentra Niagatama Indonesia tercatat dalam dokumen pendirian dengan kode KBLI 2025. Halaman ini menjelaskan cakupan tersebut beserta alur kerja yang digunakan."
  />

  <section class="section" aria-labelledby="bidang-title">
    <div class="container">
      <SectionHeading
        index="01"
        label="Bidang Usaha"
        title="Tiga kegiatan usaha yang tercatat."
        headingId="bidang-title"
      >
        <div class="bidang">
          <div class="prose">
            <p>
              Kegiatan usaha utama perusahaan adalah penyelenggaraan platform digital untuk
              perdagangan eceran. Klasifikasi berikut adalah kode KBLI 2025 pada dokumen
              pendirian, bukan daftar produk yang dijual.
            </p>
            <p>
              Cakupan produk dan syarat kerja ditetapkan per kesepakatan, sehingga persyaratan
              mengikuti kebutuhan nyata mitra dan tidak bergantung pada asumsi umum.
            </p>
          </div>

          <div class="bidang__note">
            <p class="bidang__note-title">Dasar pencatatan</p>
            <p class="bidang__note-text">
              Kode KBLI 47901 tercantum dengan status terbit pada lampiran Nomor Induk Berusaha.
              Kode 53301 dan 47709 tercatat pada Surat Pernyataan Pendirian.
            </p>
          </div>
        </div>

        <ul class="lines">
          {
            businessLines.map((line) => (
              <li class="lines__item">
                <p class="lines__code">KBLI {line.code}</p>
                <h3 class="lines__title">{line.title}</h3>
                <p class="lines__desc">{line.description}</p>
              </li>
            ))
          }
        </ul>
      </SectionHeading>
    </div>
  </section>

  <section class="section section--canvas" id="cara-kerja" aria-labelledby="cara-kerja-title">
    <div class="container">
      <SectionHeading
        index="02"
        label="Cara Kerja"
        title="Lima tahap dari kebutuhan hingga tindak lanjut."
        headingId="cara-kerja-title"
        intro="Alur berikut menggambarkan urutan kerja yang digunakan untuk memastikan setiap permintaan ditangani dengan rujukan yang sama."
      >
        <ProcessSteps />
      </SectionHeading>
    </div>
  </section>

  <section class="section" aria-labelledby="informasi-title">
    <div class="container">
      <SectionHeading
        index="03"
        label="Informasi untuk Permintaan"
        title="Agar diskusi langsung masuk ke hal yang relevan."
        headingId="informasi-title"
        intro="Saat menyampaikan permintaan, sertakan informasi berikut bila sudah tersedia."
      >
        <ul class="checklist">
          <li class="checklist__item">Jenis transaksi atau layanan yang dibutuhkan</li>
          <li class="checklist__item">Kategori barang atau mitra yang akan terlibat</li>
          <li class="checklist__item">Perkiraan volume dan jangka waktu kegiatan</li>
          <li class="checklist__item">Kanal atau sistem yang sudah digunakan, bila ada</li>
          <li class="checklist__item">Lokasi pengiriman atau jangkauan layanan</li>
          <li class="checklist__item">Dokumen pendukung, bila diperlukan</li>
        </ul>
        <p class="checklist__note">
          Informasi tersebut membantu penyusunan tanggapan yang sesuai. Kelengkapan data juga
          mempercepat proses klarifikasi.
        </p>
      </SectionHeading>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .bidang {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .bidang {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  .bidang__note {
    padding-left: var(--space-5);
    border-left: 2px solid var(--brand-red);
  }

  .bidang__note-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brand-navy);
  }

  .bidang__note-text {
    margin-top: var(--space-3);
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    max-width: 38ch;
  }

  .lines {
    display: grid;
    gap: 0;
    margin-top: var(--space-7);
    border-top: var(--border);
  }

  @media (min-width: 720px) {
    .lines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  .lines__item {
    padding-block: var(--space-5);
    border-bottom: var(--border);
  }

  @media (min-width: 720px) {
    .lines__item {
      border-bottom: none;
    }
  }

  .lines__code {
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brand-red);
  }

  .lines__title {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    line-height: 1.35;
    max-width: 26ch;
  }

  .lines__desc {
    margin-top: var(--space-2);
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 38ch;
  }

  .checklist {
    display: grid;
    gap: 0;
  }

  @media (min-width: 720px) {
    .checklist {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  .checklist__item {
    position: relative;
    padding-block: var(--space-4);
    padding-left: var(--space-5);
    border-top: var(--border);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .checklist__item::before {
    content: "";
    position: absolute;
    top: 1.45rem;
    left: 0;
    width: 7px;
    height: 7px;
    background-color: var(--brand-red);
  }

  .checklist__note {
    margin-top: var(--space-5);
    max-width: 60ch;
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
</style>
