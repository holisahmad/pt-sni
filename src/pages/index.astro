---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { company } from '../data/company';
import { businessLines, principles } from '../data/content';

const title = 'PT Sentra Niagatama Indonesia | Perdagangan Eceran Digital';
const description =
  'PT Sentra Niagatama Indonesia adalah perseroan perorangan yang bergerak di bidang perdagangan eceran digital, berbasis di Gamping, Sleman, Yogyakarta.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.legalName,
  legalName: company.legalName,
  description,
  ...(Astro.site ? { url: Astro.site.href } : {}),
  foundingDate: company.founded.iso,
  ...(company.contact.email ? { email: company.contact.email } : {}),
  ...(company.contact.phoneHref ? { telephone: company.contact.phoneHref } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mejing Wetan, RT 003/RW 004, Ambarketawang',
    addressLocality: company.contact.addressLocality,
    addressRegion: company.contact.addressRegion,
    postalCode: company.contact.postalCode,
    addressCountry: 'ID',
  },
  identifier: {
    '@type': 'PropertyValue',
    name: 'Nomor Induk Berusaha',
    value: company.legal.nib,
  },
};
---

<BaseLayout title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />

  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow">
          <span class="marker" aria-hidden="true"></span>
          {company.legalName}
        </p>
        <h1 class="hero__title">Perdagangan eceran digital dengan proses yang dapat diikuti.</h1>
        <p class="hero__description">
          PT Sentra Niagatama Indonesia menjalankan kegiatan perdagangan eceran melalui platform
          digital, layanan portal intermediasi pos dan kurir, serta perdagangan eceran barang baru.
          Kami berbasis di Gamping, Sleman, Daerah Istimewa Yogyakarta.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/kontak">
            Hubungi Kami
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a class="btn btn--secondary" href="/tentang-kami">Kenali Perusahaan</a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="hero__visual-head">
          <p class="hero__visual-label">Bidang usaha</p>
          <span class="hero__visual-index">01</span>
        </div>
        <div class="hero__visual-foot">
          <p class="hero__visual-value">Perdagangan digital</p>
          <span class="hero__visual-rule"></span>
          <p class="hero__visual-meta">NIB {company.legal.nib}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="profil-title">
    <div class="container">
      <SectionHeading
        index="01"
        label="Profil Perusahaan"
        title="Perdagangan eceran digital dari Sleman."
        headingId="profil-title"
      >
        <div class="prose">
          <p>
            PT Sentra Niagatama Indonesia adalah perseroan perorangan dengan skala usaha mikro
            yang disahkan pada 14 Juli 2026 dan berkedudukan di Kabupaten Sleman, Daerah Istimewa
            Yogyakarta.
          </p>
          <p>
            Kegiatan usahanya berpusat pada perdagangan eceran melalui platform digital, layanan
            portal intermediasi pos dan kurir, serta perdagangan eceran barang baru.
          </p>
          <p>
            <a class="link-arrow" href="/tentang-kami">Selengkapnya tentang perusahaan</a>
          </p>
        </div>
      </SectionHeading>
    </div>
  </section>

  <section class="section section--canvas" aria-labelledby="bidang-title">
    <div class="container">
      <SectionHeading
        index="02"
        label="Bidang Perdagangan"
        title="Kegiatan usaha yang tercatat."
        headingId="bidang-title"
      >
        <div class="bidang">
          <div class="prose">
            <p>
              Kegiatan usaha perusahaan tercatat pada dokumen pendirian dan Nomor Induk Berusaha.
              Klasifikasi di bawah ini mengikuti KBLI 2025, bukan daftar produk yang dijual.
            </p>
            <p>
              Cakupan produk dan syarat kerja ditetapkan per kesepakatan. Dengan begitu, persyaratan
              kerja mengikuti kebutuhan nyata mitra dan tidak bergantung pada asumsi umum.
            </p>
          </div>

          <div>
            <ul class="bidang__lines">
              {
                businessLines.map((line) => (
                  <li class="bidang__line">
                    <span class="bidang__line-code">KBLI {line.code}</span>
                    <span class="bidang__line-title">{line.title}</span>
                    <span class="bidang__line-desc">{line.description}</span>
                  </li>
                ))
              }
            </ul>
            <p class="section-link">
              <a class="link-arrow" href="/layanan">Bidang usaha dan cara kerja</a>
            </p>
          </div>
        </div>
      </SectionHeading>
    </div>
  </section>

  <section class="section" aria-labelledby="cara-kerja-title">
    <div class="container">
      <SectionHeading
        index="03"
        label="Cara Kerja"
        title="Alur kerja yang sederhana dan terdokumentasi."
        headingId="cara-kerja-title"
      >
        <ProcessDiagram />
        <p class="section-link">
          <a class="link-arrow" href="/layanan#cara-kerja">Lihat detail alur kerja</a>
        </p>
      </SectionHeading>
    </div>
  </section>

  <section class="section section--canvas" aria-labelledby="prinsip-title">
    <div class="container">
      <SectionHeading
        index="04"
        label="Prinsip Kerja"
        title="Yang kami pegang dalam setiap proses."
        headingId="prinsip-title"
      >
        <ul class="principles">
          {
            principles.map((principle) => (
              <li class="principles__item">
                <h3 class="principles__title">{principle.title}</h3>
                <p class="principles__description">{principle.description}</p>
              </li>
            ))
          }
        </ul>
      </SectionHeading>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: stretch;
      column-gap: var(--space-9);
    }
  }

  .hero__title {
    margin-top: var(--space-5);
    max-width: 17ch;
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: -0.032em;
  }

  .hero__description {
    margin-top: var(--space-5);
    max-width: 52ch;
    color: var(--neutral-muted);
    font-size: var(--text-lg);
    line-height: 1.62;
  }

  @media (max-width: 380px) {
    .hero__title {
      font-size: 2rem;
    }
  }

  .hero .btn-row {
    margin-top: var(--space-7);
  }

  /* Komposisi editorial, bukan foto stok */
  .hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 260px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    overflow: hidden;
    background-color: var(--brand-navy);
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.09) 0 1px,
      transparent 1px 32px
    );
  }

  .hero__visual::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 96px;
    background-color: var(--brand-red);
  }

  .hero__visual-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hero__visual-index {
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.16em;
    color: var(--on-navy-muted);
  }

  .hero__visual-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-navy-muted);
  }

  .hero__visual-foot {
    position: relative;
  }

  .hero__visual-value {
    color: var(--on-navy);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__visual-rule {
    display: block;
    height: 1px;
    margin-block: var(--space-4) var(--space-3);
    background-color: var(--on-navy-line);
  }

  .hero__visual-meta {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--on-navy-muted);
  }

  @media (max-width: 479px) {
    .hero .btn-row {
      flex-direction: column;
      align-items: stretch;
    }

    .hero .btn-row .btn {
      width: 100%;
    }
  }

  /* Bidang perdagangan */
  .bidang {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .bidang {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  .bidang__lines {
    border-top: var(--border);
  }

  .bidang__line {
    display: grid;
    gap: 0.3rem;
    padding-block: var(--space-4);
    border-bottom: var(--border);
  }

  .bidang__line-code {
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.14em;
    color: var(--brand-red);
  }

  .bidang__line-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--brand-navy);
  }

  .bidang__line-desc {
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 46ch;
  }

  .section-link {
    margin-top: var(--space-6);
  }

  /* Prinsip kerja */
  .principles {
    display: grid;
    gap: 0;
  }

  @media (min-width: 720px) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  .principles__item {
    border-top: var(--border);
    padding-block: var(--space-4) var(--space-5);
  }

  .principles__title {
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .principles__description {
    margin-top: var(--space-2);
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
