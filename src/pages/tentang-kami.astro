---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { company } from '../data/company';
import { factSheet, principles } from '../data/content';
---

<BaseLayout
  title="Tentang Kami | PT Sentra Niagatama Indonesia"
  description="Profil PT Sentra Niagatama Indonesia: perseroan perorangan berskala usaha mikro di Sleman, Yogyakarta, dengan bidang usaha perdagangan eceran digital."
>
  <PageHero
    eyebrow="Tentang Kami"
    title="Perusahaan perdagangan eceran digital yang tercatat resmi."
    intro={`${company.legalName} adalah perseroan perorangan berskala usaha mikro yang berkedudukan di Sleman, Daerah Istimewa Yogyakarta.`}
  />

  <section class="section" aria-labelledby="profil-title">
    <div class="container">
      <SectionHeading
        index="01"
        label="Profil Perusahaan"
        title="Perseroan perorangan dengan kegiatan usaha yang tercatat."
        headingId="profil-title"
      >
        <div class="prose">
          <p>
            {company.legalName} didirikan sebagai perseroan perorangan untuk usaha mikro. Pendirian
            disahkan pada {company.legal.deedDate} melalui {company.legal.deedLabel} bernomor
            {company.legal.deed}, dan Nomor Induk Berusaha diterbitkan pada {company.legal.nibIssued}.
          </p>
          <p>
            Kegiatan usaha berpusat pada perdagangan eceran melalui platform digital, layanan portal
            intermediasi pos dan kurir, serta perdagangan eceran barang baru. Ketiganya tercatat
            dalam dokumen pendirian dengan kode KBLI 2025 yang berlaku.
          </p>
          <p>
            Domisili perusahaan berada di Gamping, Kabupaten Sleman, Daerah Istimewa Yogyakarta.
            Informasi kontak resmi tersedia pada halaman kontak untuk kebutuhan penawaran maupun
            pertanyaan tertulis.
          </p>
          <p>
            <a class="link-arrow" href="/layanan">Bidang usaha dan alur kerja</a>
          </p>
        </div>
      </SectionHeading>
    </div>
  </section>

  <section class="section section--canvas" aria-labelledby="prinsip-title">
    <div class="container">
      <SectionHeading
        index="02"
        label="Prinsip Kerja"
        title="Tiga hal yang kami jaga dalam setiap proses."
        headingId="prinsip-title"
      >
        <ul class="principles">
          {
            principles.map((principle) => (
              <li class="principles__item">
                <h3 class="principles__title">{principle.title}</h3>
                <p class="principles__description">{principle.description}</p>
              </li>
            ))
          }
        </ul>
      </SectionHeading>
    </div>
  </section>

  <section class="section" aria-labelledby="informasi-title">
    <div class="container">
      <SectionHeading
        index="03"
        label="Informasi Perusahaan"
        title="Data perusahaan menurut dokumen resmi."
        headingId="informasi-title"
      >
        <dl class="fact-sheet">
          {
            factSheet.map((row) => (
              <div class="fact-sheet__row">
                <dt>{row.label}</dt>
                <dd>
                  {row.value ? (
                    row.value
                  ) : (
                    <span class="fact-sheet__pending">Belum dipublikasikan</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="fact-sheet__note">
          Data di atas mengacu pada {company.legal.deedLabel} dan dokumen Nomor Induk Berusaha.
          Nomor rekening, nomor identitas pendiri, serta dokumen perpajakan tidak dipublikasikan
          pada situs ini.
        </p>
      </SectionHeading>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .principles {
    display: grid;
    gap: 0;
  }

  @media (min-width: 720px) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  .principles__item {
    border-top: var(--border);
    padding-block: var(--space-4) var(--space-5);
  }

  .principles__title {
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .principles__description {
    margin-top: var(--space-2);
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 38ch;
  }

  .fact-sheet {
    border-top: var(--border);
    margin: 0;
  }

  .fact-sheet__row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: var(--border);
  }

  @media (min-width: 720px) {
    .fact-sheet__row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: baseline;
      gap: var(--space-4);
    }
  }

  .fact-sheet dt {
    color: var(--neutral-muted);
    font-size: var(--text-sm);
  }

  .fact-sheet dd {
    margin: 0;
    color: var(--neutral-ink);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .fact-sheet__pending {
    color: var(--neutral-muted);
    font-weight: 400;
    font-style: normal;
  }

  .fact-sheet__pending::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 1px;
    margin-right: var(--space-2);
    vertical-align: middle;
    background-color: var(--neutral-line);
  }

  .fact-sheet__note {
    margin-top: var(--space-5);
    max-width: 60ch;
    color: var(--neutral-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
</style>
