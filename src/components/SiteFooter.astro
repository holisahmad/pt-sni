---
import { company } from '../data/company';
import { mainNavigation } from '../data/content';

const year = new Date().getFullYear();
const navItems = mainNavigation.filter((item) => item.href !== '/');
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="footer-wordmark">
        <span class="footer-wordmark__name">PT Sentra Niagatama</span>
        <span class="footer-wordmark__country">Indonesia</span>
      </p>
      <p class="site-footer__summary">{company.summary}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Navigasi footer">
      <p class="site-footer__heading">Navigasi</p>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__contact">
      <p class="site-footer__heading">Kontak</p>
      <p class="site-footer__note">
        Kanal kontak resmi ditampilkan pada halaman kontak setelah diverifikasi oleh perusahaan.
      </p>
      <a class="site-footer__link" href="/kontak">Lihat halaman kontak</a>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {company.legalName}.</p>
    <ul class="site-footer__legal">
      <li><a href="/kebijakan-privasi">Kebijakan Privasi</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--brand-navy-deep);
    color: var(--on-navy);
    padding-block: clamp(3rem, 6vw, 4.5rem) var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 720px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-8);
    }
  }

  .footer-wordmark {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1;
  }

  .footer-wordmark__name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.085em;
    text-transform: uppercase;
  }

  .footer-wordmark__country {
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--on-navy-muted);
  }

  .site-footer__summary {
    margin-top: var(--space-4);
    max-width: 38ch;
    color: var(--on-navy-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .site-footer__heading {
    margin: 0 0 var(--space-4);
    color: var(--on-navy);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .site-footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__nav a {
    color: var(--on-navy-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__nav a:hover {
    color: var(--on-navy);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__note {
    max-width: 34ch;
    color: var(--on-navy-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .site-footer__link {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--on-navy);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--on-navy-line);
    text-decoration-thickness: 1px;
  }

  .site-footer__link:hover {
    text-decoration-color: var(--on-navy);
    text-decoration-thickness: 2px;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--on-navy-line);
    color: var(--on-navy-muted);
    font-size: var(--text-xs);
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-4);
  }

  .site-footer__legal a {
    color: var(--on-navy-muted);
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    color: var(--on-navy);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
