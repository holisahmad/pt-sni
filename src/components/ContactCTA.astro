---
import { ArrowRight } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mari bahas kebutuhan perdagangan Anda.',
  description = 'Sampaikan konteks kebutuhan Anda — jenis barang, perkiraan jumlah, dan waktu yang diharapkan — agar diskusi langsung masuk ke hal yang relevan.',
} = Astro.props;
---

<section class="contact-cta" aria-labelledby="contact-cta-title">
  <div class="container contact-cta__inner">
    <div class="contact-cta__text">
      <p class="eyebrow">
        <span class="marker" aria-hidden="true"></span>
        Langkah berikutnya
      </p>
      <h2 id="contact-cta-title">{title}</h2>
      <p class="contact-cta__description">{description}</p>
    </div>

    <div class="contact-cta__actions">
      <a class="btn btn--primary" href="/kontak">
        Hubungi Kami
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a class="btn btn--on-navy" href="/layanan#cara-kerja">Lihat cara kerja</a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    background-color: var(--brand-navy);
    color: var(--on-navy);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 3px solid var(--brand-red);
  }

  .contact-cta__inner {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 900px) {
    .contact-cta__inner {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: end;
      column-gap: var(--space-9);
    }
  }

  .contact-cta__text h2 {
    margin-top: var(--space-5);
    max-width: 24ch;
    color: var(--on-navy);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.028em;
  }

  .contact-cta__description {
    margin-top: var(--space-4);
    max-width: 56ch;
    color: var(--on-navy-muted);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .contact-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 900px) {
    .contact-cta__actions {
      justify-content: flex-end;
    }
  }
</style>
